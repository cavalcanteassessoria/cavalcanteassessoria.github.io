---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { ui } from './ui-copy';
import Icon from './Icon.astro';
import heroImage from '../assets/img/justica-estatueta.jpg';

const taglineWords = site.tagline.split(' ');
const headFirst = taglineWords.slice(0, 4).join(' ');
const headRest = taglineWords.slice(4);
---

<section id="inicio" class="hero grain" aria-labelledby="hero-title">
  <div class="hero__media">
    <Image
      src={heroImage}
      alt={ui.heroImageAlt}
      widths={[480, 720, 960, 1200, 1600]}
      sizes="(min-width: 64em) 44vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
    <span class="hero__frame" aria-hidden="true"></span>
    <p class="hero__aside" aria-hidden="true">
      <span>{ui.heroAside}</span>
      <span class="hero__aside-sep"></span>
      <span>{site.location}</span>
    </p>
  </div>

  <div class="hero__body">
    <p class="eyebrow hero__eyebrow">{site.name}</p>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line">{headFirst}</span>
      <span class="hero__line hero__line--accent">{headRest.join(' ')}</span>
    </h1>
    <p class="hero__lead">{site.heroSubtitle}</p>

    <div class="hero__actions">
      <a class="btn" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" />
        {ui.whatsappCta}
        <span class="visually-hidden">{ui.newTab}</span>
      </a>
      <a class="hero__phone" href={`tel:${site.phone.tel}`}>
        <Icon name="phone" />
        <span>{site.phone.display}</span>
      </a>
    </div>

    <dl class="hero__scope">
      <dt class="eyebrow">{ui.heroScope}</dt>
      <dd>{site.description}</dd>
    </dl>
  </div>
</section>

<style>
  .hero {
    display: grid;
    background:
      radial-gradient(ellipse 70% 60% at 0% 100%, rgb(180 129 107 / 0.12), transparent 70%),
      var(--ink);
    color: var(--text-dark);
    overflow: hidden;
  }

  .hero__media {
    position: relative;
    height: min(62svh, 34rem);
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 60%;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(11 10 9 / 0.15) 0%, transparent 35%, rgb(11 10 9 / 0.75) 78%, var(--ink) 100%);
  }

  .hero__frame,
  .hero__aside {
    display: none;
  }

  .hero__body {
    position: relative;
    z-index: 1;
    margin-top: -7rem;
    padding: 0 var(--gutter) clamp(3.5rem, 8vw, 5rem);
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--bronze);
  }

  .hero__eyebrow::before {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }

  .hero__title {
    margin-top: 1.5rem;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .hero__line {
    display: block;
    text-wrap: balance;
  }

  .hero__line--accent {
    color: var(--bronze);
  }

  .hero__lead {
    max-width: 42ch;
    margin-top: 1.75rem;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    color: var(--muted-dark);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.5rem;
  }

  .hero__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.5rem;
    font-family: var(--serif);
    font-size: 1.35rem;
    text-decoration: none;
    color: var(--text-dark);
    background: linear-gradient(var(--bronze), var(--bronze)) left bottom / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease);
  }

  .hero__phone:hover {
    background-size: 100% 1px;
  }

  .hero__phone :global(.icon) {
    color: var(--bronze);
  }

  .hero__scope {
    display: grid;
    gap: 0.6rem;
    max-width: 34rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
  }

  .hero__scope dt {
    color: var(--bronze);
  }

  .hero__scope dd {
    font-size: 0.95rem;
    color: var(--muted-dark);
  }

  @media (min-width: 48em) {
    .hero__media {
      height: 70svh;
      max-height: 44rem;
    }

    .hero__body {
      margin-top: -12rem;
    }
  }

  @media (min-width: 64em) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
      min-height: calc(100svh - var(--header-h));
    }

    .hero__media {
      grid-column: 2;
      grid-row: 1;
      height: auto;
      max-height: none;
    }

    .hero__media::after {
      background: linear-gradient(90deg, var(--ink) 0%, rgb(11 10 9 / 0.35) 22%, transparent 45%);
    }

    .hero__frame {
      display: block;
      position: absolute;
      z-index: 2;
      top: 3.5rem;
      bottom: 3.5rem;
      left: -3.5rem;
      right: 3.5rem;
      border: 1px solid var(--line-dark);
      pointer-events: none;
    }

    .hero__aside {
      display: flex;
      align-items: center;
      gap: 1rem;
      position: absolute;
      z-index: 2;
      right: 1.25rem;
      bottom: 3.5rem;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--text-dark);
    }

    .hero__aside-sep {
      width: 1px;
      height: 3rem;
      background: var(--bronze);
    }

    .hero__body {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      margin: 0;
      padding-block: 5rem;
      padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2)) 4rem;
    }

    .hero__scope {
      max-width: 30rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__body > * {
      animation: hero-in 1.1s var(--ease) both;
    }

    .hero__body > :nth-child(2) {
      animation-delay: 0.12s;
    }

    .hero__body > :nth-child(3) {
      animation-delay: 0.24s;
    }

    .hero__body > :nth-child(4) {
      animation-delay: 0.36s;
    }

    .hero__body > :nth-child(5) {
      animation-delay: 0.5s;
    }

    .hero__img {
      animation: hero-img 1.8s var(--ease) both;
    }

    .hero__frame {
      animation: hero-frame 1.4s 0.4s var(--ease) both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @keyframes hero-img {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes hero-frame {
    from {
      opacity: 0;
      transform: translate(1.5rem, -1.5rem);
    }
  }
</style>
