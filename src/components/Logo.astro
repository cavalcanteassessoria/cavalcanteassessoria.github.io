---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['logo', className]} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="16" cy="4.2" r="1.3" vector-effect="non-scaling-stroke"></circle>
    <path d="M16 5.5v19.5M4.5 9.5c3.8-1.6 7.6-2 11.5-2s7.7.4 11.5 2" vector-effect="non-scaling-stroke"></path>
    <path d="M6.5 9 3.4 17.2M6.5 9l3.1 8.2M2.6 17.2h7.8a3.9 3.4 0 0 1-7.8 0z" vector-effect="non-scaling-stroke"></path>
    <path d="M25.5 9l-3.1 8.2M25.5 9l3.1 8.2M21.6 17.2h7.8a3.9 3.4 0 0 1-7.8 0z" vector-effect="non-scaling-stroke"></path>
    <path d="M12.5 25h7M10.5 27.2h11M8.5 29.4h15" vector-effect="non-scaling-stroke"></path>
  </g>
</svg>

<style>
  .logo {
    width: 2rem;
    height: 2rem;
    color: var(--bronze);
  }
</style>
