---
export type IconName =
  | 'phone'
  | 'mail'
  | 'instagram'
  | 'pin'
  | 'whatsapp'
  | 'book'
  | 'arrow'
  | 'arrow-up-right'
  | 'arrow-up'
  | 'menu'
  | 'close'
  | 'pericia'
  | 'assistencia'
  | 'consultoria'
  | 'calculos'
  | 'contratos'
  | 'trabalhista';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;

const paths: Record<IconName, string> = {
  phone:
    '<path d="M5 4h3.2l1.8 4.6-2.3 1.5a11.5 11.5 0 0 0 6.2 6.2l1.5-2.3 4.6 1.8V19a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14"/><path d="m3 6 9 7 9-7"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6"/>',
  pin: '<path d="M12 21s-6.5-6-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 15 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.4"/>',
  whatsapp:
    '<path d="M3.6 20.4 4.9 16A8.6 8.6 0 1 1 8 19.2z"/><path d="M9.2 8.2c-.4.9-.2 2.4 1.3 4.1s3.1 2.2 4.2 1.8l.7-1.3-1.8-1-.8.7a4.4 4.4 0 0 1-2.1-2.1l.7-.8-1-1.8z"/>',
  book: '<path d="M12 6.5C9.8 5 6.8 4.5 3.5 5v13.5c3.3-.5 6.3 0 8.5 1.5 2.2-1.5 5.2-2 8.5-1.5V5c-3.3-.5-6.3 0-8.5 1.5z"/><path d="M12 6.5V20"/>',
  arrow: '<path d="M4 12h16M14 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  'arrow-up': '<path d="M12 20V4M6 10l6-6 6 6"/>',
  menu: '<path d="M3 8.5h18M3 15.5h18"/>',
  close: '<path d="m5 5 14 14M19 5 5 19"/>',
  pericia:
    '<path d="M13 3H5.5v18H11"/><path d="M13 3l4.5 4.5V10"/><path d="M13 3v4.5h4.5"/><path d="M8 11h4M8 14h2"/><circle cx="15.5" cy="15.5" r="3.5"/><path d="m18 18 3 3"/>',
  assistencia:
    '<rect x="3" y="7" width="18" height="13"/><path d="M9 7V4.5h6V7M3 12.5h18M10.5 12.5v2h3v-2"/>',
  consultoria:
    '<path d="M4.5 21V5.5L12 3v18M12 9l7.5 2.2V21M2.5 21h19"/><path d="M7.5 8.5h1.5M7.5 12h1.5M7.5 15.5h1.5M15 14h1.5M15 17.5h1.5"/>',
  calculos:
    '<rect x="5" y="3" width="14" height="18"/><rect x="8" y="6" width="8" height="3.5"/><path d="M8.5 13h1M11.5 13h1M14.5 13h1M8.5 16.5h1M11.5 16.5h1M14.5 16.5h1"/>',
  contratos:
    '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4M9 9.5h7M9 12.5h7"/><path d="M8.8 17.6c.9-1.5 1.8-1.6 2.4-.3.5 1.2 1.3 1.1 2.1-.2.6-1 1.2-.9 1.6.3.3.8 1 .9 1.8.4"/>',
  trabalhista:
    '<path d="M2.5 17.5h19v2.5h-19zM4.5 17.5V16a7.5 7.5 0 0 1 15 0v1.5"/><path d="M10 9V5.5h4V9M9 17.5V13M15 17.5V13"/>',
};
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
